#!/bin/bash

force=$(if [[ $1 == "--force" ]]; then echo true; else echo false; fi)
bin_dir=$(dirname $(readlink -f ${BASH_SOURCE[0]}))
files_dir=$(realpath "$bin_dir/../")

while IFS= read -r line; do
  files+=("$line")
done < <(find $files_dir -type f -not -path "*.git/*" -not -path "*/bin/*" -not -path "$files_dir/plugins/*" -not -path "*README*")

# printf '%s\n' "${files[@]}"

# Run clean script when force flag is given.
[[ $force == true ]] && "$bin_dir/clean"

skipped=()

for source in "${files[@]}"; do
  destination="$HOME${source/$files_dir/}"
  directory=$(dirname "$destination")

  # Already linked (directly or through a linked parent folder).
  [[ -e $destination && $(readlink -f "$destination") == "$source" ]] && continue

  # Leave anything else in the way alone: real files, or links pointing elsewhere.
  if [[ -e $destination || -L $destination ]]; then
    echo "Skipping $destination: it already exists and is not a link to $source."
    skipped+=("$destination")
    continue
  fi

  if [[ ! -d $directory ]]; then
    echo "Creating directory $directory..."
    mkdir -p "$directory"
    rc=$?
    [[ $rc -ne 0 ]] && echo "Failed creating directory $directory." && exit $rc
  fi

  echo "Creating symlink $source --> $destination..."
  ln -s "$source" "$destination"
  rc=$?
  [[ $rc -ne 0 ]] && echo "Failed creating symlink $source --> $destination." && exit $rc
done

if [[ ${#skipped[@]} -gt 0 ]]; then
  echo
  echo "Skipped ${#skipped[@]} path(s) that are in the way. Move them aside and run again:"
  printf '  %s\n' "${skipped[@]}"
  exit 1
fi
