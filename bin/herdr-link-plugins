#!/bin/bash
# Link every herdr plugin kept in .dotfiles/.config/herdr/plugins (any dir with
# a herdr-plugin.toml) so herdr loads it straight from the repo.

files_dir=$(realpath "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../")
plugins_dir="$files_dir/.config/herdr/plugins"

command -v herdr >/dev/null 2>&1 || { echo "herdr not found on PATH" >&2; exit 1; }

status=0
for manifest in "$plugins_dir"/*/herdr-plugin.toml; do
  [ -f "$manifest" ] || continue
  dir=$(dirname "$manifest")
  if out=$(herdr plugin link "$dir" 2>&1) && ! grep -q '"error"' <<<"$out"; then
    echo "linked $(basename "$dir")"
  else
    echo "failed $(basename "$dir"): $out" >&2
    status=1
  fi
done

exit $status
